# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore: segredos nunca vão para o GitHub.

PORT=3000

# Segredo usado para assinar os tokens JWT (mínimo 32 caracteres).
# Gere um aleatório com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1h

# Custo do bcrypt (10 a 12 é o recomendado)
BCRYPT_ROUNDS=10

# Tentativas de login/registro por IP a cada 15 minutos (proteção contra força bruta)
AUTH_RATE_LIMIT=20

# Origem permitida no CORS (ex.: https://meu-frontend.com). "*" libera todas.
CORS_ORIGIN=*

# Em produção (Render), use NODE_ENV=production
NODE_ENV=development

# Primeiro administrador, criado ao subir a API (opcional).
# O registro público (POST /register) sempre cria usuários com perfil "comum".
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@loja.com
ADMIN_SENHA=troque-esta-senha-123
