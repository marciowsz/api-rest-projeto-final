        {
          "name": "Listar produtos paginados, filtrados e ordenados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const { data: itens, meta } = pm.response.json();",
                  "pm.test(\"Formato { data, meta } com links HATEOAS\", () => {",
                  "  pm.expect(itens.length).to.be.at.most(5);",
                  "  pm.expect(meta).to.include.keys(\"totalItems\", \"itemsPerPage\", \"currentPage\", \"totalPages\", \"links\");",
                  "  pm.expect(meta.links.first).to.include(\"page=1\");",
                  "});",
                  "pm.test(\"Filtros e ordenação aplicados\", () => {",
                  "  itens.forEach((p) => { pm.expect(p.categoria).to.eql(\"eletronicos\"); pm.expect(p.preco).to.be.within(100, 5000); });",
                  "  const precos = itens.map((p) => p.preco);",
                  "  pm.expect(precos).to.eql([...precos].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produtos?page=1&limit=5&sort=preco&order=desc&categoria=eletronicos&minPrice=100&maxPrice=5000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ],
              "query": [
