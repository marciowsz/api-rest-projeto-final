                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "preco"
                },
                {
                  "key": "order",
                  "value": "desc"
                },
                {
                  "key": "categoria",
                  "value": "eletronicos"
                },
                {
                  "key": "minPrice",
                  "value": "100"
                },
                {
                  "key": "maxPrice",
                  "value": "5000"
                }
              ]
            }
          },
          "response": []
